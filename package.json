{
  "name": "screenflow",
  "private": true,
  "version": "0.1.0",
  "description": "ScreenFlow — Screen Recording + Video Editor + Guide Generator + Training Academy",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "db:generate": "turbo db:generate --filter=@screenflow/db",
    "db:push": "turbo db:push --filter=@screenflow/db",
    "db:migrate": "turbo db:migrate --filter=@screenflow/db"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
